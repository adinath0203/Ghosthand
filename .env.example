# ==============================================================================
# Provider selection: "vercel" (default) or "openrouter".
# If AI_PROVIDER is empty and only OPENROUTER_API_KEY is set, OpenRouter is used.
# ==============================================================================
AI_PROVIDER=openrouter

# [OpenRouter] API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# ~typesafe/jev-latest = the Jev decision model GhostHand was designed for (called natively via
# /api/alpha/decisions). Any JSON-capable chat model also works, e.g. openai/gpt-4.1-mini
OPENROUTER_MODEL=~typesafe/jev-latest
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==============================================================================
# GhostHand Configuration - Vercel AI Gateway & Jev Model
# ==============================================================================

# [REQUIRED] Your Vercel AI Gateway API Key
# Generated from 'npx vercel ai-gateway setup' or copied from:
# https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# [OPTIONAL] AI Gateway Endpoint & Model Configuration
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
JEV_MODEL=typesafe-ai/jev

# [OPTIONAL] Privacy & Data Retention
# When true, passes providerOptions.gateway.zeroDataRetention = true
ZERO_DATA_RETENTION=false

# [OPTIONAL] Model Decision & Safety Thresholds
# Confidence threshold for action selection (0.0 to 1.0)
DECISION_CONFIDENCE_THRESHOLD=0.0
# Risk escalation threshold
RISK_CONFIDENCE_THRESHOLD=0.70

# [OPTIONAL] Execution Mode & Limits
# Set to 'false' to allow GhostHand to click and type on real windows
# Set to 'true' to simulate and print actions only
DRY_RUN=true
MAX_STEPS_PER_RUN=30

# [OPTIONAL] Test Gating
# Set to 1 to enable live integration tests that call Vercel AI Gateway
JEV_LIVE_TESTS=0

# [OPTIONAL] Voice input (local Whisper, offline)
# tiny (~75MB, fastest) | base (~142MB, noticeably more accurate for accents/song names) | small (~466MB)
GHOSTHAND_WHISPER_MODEL=base
# auto | en | hi ... ("en" keeps Hindi song names in Latin letters, which search better)
GHOSTHAND_SPEECH_LANGUAGE=en
# Final transcript engine: whisper (local, free) | deepgram (Deepgram Nova-3 via OpenRouter, uses OPENROUTER_API_KEY,
# more accurate, ~$0.0001 per command). Live partials and early actions always use local Whisper (fastest).
GHOSTHAND_STT=deepgram
# GHOSTHAND_STT_MODEL=deepgram/nova-3
# GHOSTHAND_VOICE_DEBUG=1   (traces mic levels and transcripts to %LOCALAPPDATA%/GhostHand/voice-debug.log)
